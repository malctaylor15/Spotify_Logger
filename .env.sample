# Copy this file to `.env` and fill in the two secret values below.
# `.env` is gitignored; only this sample file is committed.

# From the Spotify Developer Dashboard (developer.spotify.com/dashboard) -> app -> Settings
SPOTIPY_CLIENT_ID=sample_client_id_replace_me
SPOTIPY_CLIENT_SECRET=sample_client_secret_replace_me

# Not secret - this is just the callback URL registered for the app.
# For a headless/remote server (no local browser), point it at a domain
# that resolves to that server, e.g. https://ide.malctaylor15.com/
# For local Mac development, Spotify requires a loopback address, e.g.
# http://127.0.0.1:8888/callback
SPOTIPY_REDIRECT_URI=https://ide.malctaylor15.com/
